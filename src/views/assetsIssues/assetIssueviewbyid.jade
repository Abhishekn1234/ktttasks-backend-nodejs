extends ../layout/layout

block content
  - function formatDate(dateString) {
  -   if (!dateString) return '-';
  -   const date = new Date(dateString);
  -   const year = date.getFullYear();
  -   const month = String(date.getMonth() + 1).padStart(2, '0');
  -   const day = String(date.getDate()).padStart(2, '0');
  -   return `${year}-${month}-${day}`;
  - }

  .container
    .page-banner
      .row.align-items-center
        .col-md-8
          h1 Issue Details
          p.lead Review the selected asset issue record.

        .col-md-4.text-md-end.mt-3.mt-md-0
          a.btn.btn-light.btn-lg(href="/assetIssues") Back to Issues

    .card
      .card-body
        dl.row.mb-0
          dt.col-sm-3 Issue ID
          dd.col-sm-9= issue.issueId

          dt.col-sm-3 Employee
          dd.col-sm-9= issue.employeeName || '-'

          dt.col-sm-3 Asset
          dd.col-sm-9= issue.assetName || '-'

          dt.col-sm-3 Issue Date
          dd.col-sm-9= formatDate(issue.issueDate)

          dt.col-sm-3 Return Date
          dd.col-sm-9= formatDate(issue.returnDate)

          dt.col-sm-3 Return Reason
          dd.col-sm-9= issue.returnReason || '-'

          dt.col-sm-3 Status
          dd.col-sm-9= issue.status || '-'

          dt.col-sm-3 Remarks
          dd.col-sm-9= issue.remarks || '-'